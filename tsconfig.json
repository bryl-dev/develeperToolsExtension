{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "lib": ["es2021", "dom", "dom.iterable"],
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "types": ["chrome"],
    "noEmit": true
  },
  "include": ["src"]
}
